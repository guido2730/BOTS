<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TvVpn" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="TvButton" parent="Widget.AppCompat.Button">
        <item name="android:minWidth">320dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_button_selector</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
